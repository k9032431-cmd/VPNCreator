# Токен бота от @BotFather
BOT_TOKEN=123456:ABC-DEF
# Telegram ID главных админов через запятую (узнать свой ID: @userinfobot)
ADMIN_IDS=123456789
# Любая длинная случайная строка — ей шифруются пароли/SSH-ключи серверов в базе.
# НЕ меняйте после запуска, иначе сохранённые пароли перестанут расшифровываться.
SECRET_KEY=change-me-to-a-long-random-string
# Путь к базе
DB_PATH=data/bot.db
# Название бота в интерфейсе
BOT_TITLE=OpenVPN Creator
# Премиум-эмодзи в текстах и на кнопках (нужен Telegram Premium у владельца бота)
PREMIUM_EMOJI=true
